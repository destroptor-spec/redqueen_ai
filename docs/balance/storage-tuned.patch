diff --git a/tests/counter_builders_spec.lua b/tests/counter_builders_spec.lua
index cfa015e..e022299 100644
--- a/tests/counter_builders_spec.lua
+++ b/tests/counter_builders_spec.lua
@@ -164,6 +164,23 @@ local brain = {
     GetListOfUnits = function() return constructors end,
 }
 
+local massStorage = builders["Red Queen Mass Storage Adjacency"]
+-- Below Red Queen Engineer T2 at 917 on purpose: a ring is only bought with an
+-- engineer nothing better wanted. At 935 storage outranked engineer production
+-- and total mass built fell 22-27% with four of six wins lost.
+assert(massStorage and massStorage.Priority == 900 and massStorage.InstanceCount == 2)
+assert(massStorage.Priority < 917, "storage must not outrank engineer production")
+local massCondition = massStorage.BuilderConditions[1]
+assert(massCondition[1] == "/mods/TheRedQueen/lua/AI/RedQueen/MassStorage.lua"
+    and massCondition[2] == "HasWork" and massCondition[3][1] == "LocationType",
+    "storage eligibility must inspect the requesting base")
+local massConstruction = massStorage.BuilderData.Construction
+assert(massConstruction.RedQueenStrictMassStorage and massConstruction.AdjacencyCategory
+    and massConstruction.AdjacencyDistance == 60
+    and massConstruction.BuildStructures[1] == "MassStorage",
+    "storage job must select the strict adjacency hook")
+assert(not builders["Red Queen Energy Storage Adjacency"], "energy storage is a separate experiment")
+
 local gunshipCondition = builders["Red Queen T3 Gunship Counter"].BuilderConditions[1][1]
 assert(gunshipCondition(brain), "land-loss doctrine must enable native gunship builders")
 
