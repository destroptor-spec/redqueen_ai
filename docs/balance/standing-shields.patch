+-- What counts toward a tier's shield need, on the same rule as ground and air.
+--
+-- A Tech 2 shield is not a Tech 3 shield: it carries a fraction of the hitpoints
+-- and a smaller radius, so letting one satisfy a Tech 3 need is the defect this
+-- file records twice already -- four Tech 1 point defences answering a Ground
+-- target of four, and cheap flak answering a SAM floor.
+local function ShieldCategory(tier)
+    local shield = categories.STRUCTURE * categories.SHIELD
+    if tier >= 3 then
+        return shield * categories.TECH3
+    end
+    if tier >= 2 then
+        return shield * (categories.TECH2 + categories.TECH3)
+    end
+    return shield
+end
+
 local function NeedsT3Shield(aiBrain, locationType)
     return HasEngineer(aiBrain, locationType, 3)
         and NeedsDefense(
             aiBrain,
             locationType,
             "Shields",
-            categories.STRUCTURE * categories.SHIELD
+            ShieldCategory(3),
+            Constants.Policy.StandingShieldsPerBase
         )
 end
 
