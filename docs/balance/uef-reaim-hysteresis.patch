@@ -76,4 +76,23 @@ assert(plans.DirectionKey({ 900, 0, 800 }) ~= plans.DirectionKey({ 960, 0, 800 }
     "a genuinely different target must re-aim it")
 assert(not plans.DirectionKey(nil), "no position is no key")
 
+-- Hysteresis is scoped to UEF, and that scoping is the contract.
+--
+-- Applied to every faction it cost seven cells of twelve and took mean mass
+-- K/L from 1.44 to 0.88: re-aiming is how a platoon follows a moving battle.
+-- Both of its gains were UEF, which is 1W/5L across the baseline and too slow
+-- to finish an approach that keeps restarting.
+local uef = { GetFactionIndex = function() return 1 end }
+local fast = { GetFactionIndex = function() return 3 end }
+assert(plans.ShouldReaim(uef, nil, { 100, 0, 100 }), "an unaimed platoon takes the first objective")
+assert(not plans.ShouldReaim(uef, { 100, 0, 100 }, nil), "no objective is no order")
+assert(not plans.ShouldReaim(uef, { 100, 0, 100 }, { 130, 0, 100 }),
+    "UEF ignores drift inside the band so its approach can finish")
+assert(plans.ShouldReaim(uef, { 100, 0, 100 }, { 141, 0, 100 }),
+    "a genuinely new objective still re-aims UEF")
+assert(plans.ShouldReaim(fast, { 100, 0, 100 }, { 130, 0, 100 }),
+    "every other faction keeps the responsive bucket that measured better")
+assert(not plans.ShouldReaim(fast, { 900, 0, 800 }, { 903, 0, 802 }),
+    "a target drifting a metre is still the same target for anyone")
+
 print("Red Queen platoon plan contracts passed")
