@@ -54,6 +54,30 @@ function DirectionKey(position)
         math.floor(position[1] / 8), math.floor(position[3] / 8))
 end
 
+--- Whether the objective has moved far enough to be worth a new order.
+---
+--- Only the slow faction gets hysteresis. Applied to all four it cost seven
+--- cells of twelve and took mean mass K/L from 1.44 to 0.88 -- re-aiming is how
+--- a platoon follows a moving battle, and suppressing it commits the army to a
+--- stale target. Its only two gains were UEF, which is 1W/5L across the
+--- baseline and whose units are too slow to finish an approach that keeps
+--- restarting. Everyone else keeps the eight-unit bucket that measured better.
+function ShouldReaim(brain, pursued, position)
+    if not position then
+        return false
+    end
+    if not pursued then
+        return true
+    end
+    if not brain or brain:GetFactionIndex() ~= 1 then
+        return DirectionKey(position) ~= DirectionKey(pursued)
+    end
+    local dx = position[1] - pursued[1]
+    local dz = position[3] - pursued[3]
+    local reaim = Constants.Policy.PlatoonReaimDistance
+    return (dx * dx + dz * dz) > reaim * reaim
+end
+
 -- Direct a native-formed platoon at that objective.
 --
 -- Native forms this platoon and supplies every movement helper used here;
@@ -75,9 +99,8 @@ function ObjectiveAttack(self)
     local pursuing = nil
     while brain:PlatoonExists(self) do
         local position, kind = DirectionTarget(brain, self:GetPlatoonPosition(), "Land")
-        local key = DirectionKey(position)
-        if key and key ~= pursuing then
-            pursuing = key
+        if ShouldReaim(brain, pursuing, position) then
+            pursuing = position
             self.RedQueenDirectionPosition = position
             self:Stop()
             self:AggressiveMoveToLocation(position)
