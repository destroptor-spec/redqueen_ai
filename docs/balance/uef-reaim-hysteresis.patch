diff --git a/lua/AI/RedQueen/PlatoonPlans.lua b/lua/AI/RedQueen/PlatoonPlans.lua
index b5fa1cc..43821d5 100644
--- a/lua/AI/RedQueen/PlatoonPlans.lua
