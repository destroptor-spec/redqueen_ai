     "a genuinely different target must re-aim it")
 assert(not plans.DirectionKey(nil), "no position is no key")
 
+-- Re-aiming is hysteresis now, not a grid bucket.
+--
+-- Every re-aim issues Stop() before a fresh move, so it abandons the approach.
+-- Measured in match: the aim point changed between consecutive samples in
+-- 40-68% of them while platoons were within 35 of their target in 0-2.8%.
+-- Drift inside the band must be ignored so the approach can finish; a real
+-- change of objective must still clear it.
+assert(plans.ShouldReaim(nil, { 100, 0, 100 }), "an unaimed platoon takes the first objective")
+assert(not plans.ShouldReaim({ 100, 0, 100 }, nil), "no objective is no order")
+assert(not plans.ShouldReaim({ 100, 0, 100 }, { 130, 0, 100 }),
+    "drift inside the band must not restart the approach")
+assert(not plans.ShouldReaim({ 100, 0, 100 }, { 100, 0, 139 }),
+    "just inside the band on the other axis is still the same objective")
+assert(plans.ShouldReaim({ 100, 0, 100 }, { 141, 0, 100 }),
+    "a genuinely new objective must still re-aim")
+assert(plans.ShouldReaim({ 100, 0, 100 }, { 100, 0, 900 }),
+    "a distant objective must re-aim")
+
 print("Red Queen platoon plan contracts passed")
