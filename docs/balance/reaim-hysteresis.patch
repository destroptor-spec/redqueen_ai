         math.floor(position[1] / 8), math.floor(position[3] / 8))
 end
 
+--- Whether the objective has moved far enough to be worth a new order.
+---
+--- The 8-unit bucket above re-aimed on almost any drift, and every re-aim
+--- issues Stop() before a fresh move, so the platoon abandoned its approach and
+--- began again. Measured in match: the aim point changed between consecutive
+--- samples in 40-68% of them while platoons were within 35 of their target in
+--- 0-2.8%. They were not stuck -- they moved 72-76 units a minute -- they were
+--- chasing. Hysteresis wider than that arrival band lets an approach finish; a
+--- real change of objective still clears it.
+function ShouldReaim(pursued, position)
+    if not position then
+        return false
+    end
+    if not pursued then
+        return true
+    end
+    local dx = position[1] - pursued[1]
+    local dz = position[3] - pursued[3]
+    local reaim = Constants.Policy.PlatoonReaimDistance
+    return (dx * dx + dz * dz) > reaim * reaim
+end
+
 -- Direct a native-formed platoon at that objective.
 --
 -- Native forms this platoon and supplies every movement helper used here;
@@ -75,9 +97,8 @@ function ObjectiveAttack(self)
     local pursuing = nil
     while brain:PlatoonExists(self) do
         local position, kind = DirectionTarget(brain, self:GetPlatoonPosition(), "Land")
-        local key = DirectionKey(position)
-        if key and key ~= pursuing then
-            pursuing = key
+        if ShouldReaim(pursuing, position) then
+            pursuing = position
             self.RedQueenDirectionPosition = position
             self:Stop()
             self:AggressiveMoveToLocation(position)
