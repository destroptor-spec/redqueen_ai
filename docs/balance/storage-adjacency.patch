+-- Storage is bought for adjacency, and only where adjacency pays.
+--
+-- Every extractor is SIZE4, so each adjacent storage adds 12.5% and a 2x2
+-- skirt takes four: +50%. Tech 2 pays its 800 mass back in 4.4 minutes and
+-- Tech 3 in 1.5; Tech 1 would take 13, so it is never offered one. The
+-- hydrocarbon plant is SIZE12 and worth only 8.3% a storage, so it waits for
+-- mass that is genuinely spare.
+local massStorage = builders["Red Queen Mass Storage Adjacency"]
+local energyStorage = builders["Red Queen Energy Storage Adjacency"]
+assert(massStorage and energyStorage, "both storage builders must register")
+local massStorageCondition = massStorage.BuilderConditions[1][1]
+local energyStorageCondition = energyStorage.BuilderConditions[1][1]
+
+local massExtractorKey = (categories.STRUCTURE * categories.MASSEXTRACTION
+    * (categories.TECH2 + categories.TECH3)).Name
+local massStorageKey = (categories.STRUCTURE * categories.MASSSTORAGE).Name
+local hydroKey = (categories.STRUCTURE * categories.HYDROCARBON).Name
+local energyStorageKey = (categories.STRUCTURE * categories.ENERGYSTORAGE).Name
+
+-- Nothing upgraded yet: a Tech 1 extractor is not worth a ring of storage.
+unitCounts[massExtractorKey] = 0
+assert(not massStorageCondition(brain), "a Tech 1 only economy gets no mass storage")
+
+unitCounts[massExtractorKey] = 3
+unitCounts[massStorageKey] = 0
+assert(massStorageCondition(brain), "upgraded extractors are worth a ring of storage")
+unitCounts[massStorageKey] = 11
+assert(massStorageCondition(brain), "three extractors still want a twelfth storage")
+unitCounts[massStorageKey] = 12
+assert(not massStorageCondition(brain),
+    "four per upgraded extractor is the whole skirt; a fifth touches nothing")
+economy.StallRisk = true
+unitCounts[massStorageKey] = 0
+assert(not massStorageCondition(brain), "a stall is no time to buy storage")
+economy.StallRisk = false
+
+-- The hydrocarbon ring is a buffer and a late gain, not an energy play, so it
+-- waits for an economy that can spare 1500 mass.
+unitCounts[hydroKey] = 1
+unitCounts[energyStorageKey] = 0
+economy.MassIncome = 4
+assert(not energyStorageCondition(brain),
+    "a developing economy buys generators before it buys buffer")
+economy.MassIncome = 20
+assert(energyStorageCondition(brain), "spare mass buys the buffer")
+unitCounts[energyStorageKey] = 6
+assert(not energyStorageCondition(brain), "six a plant is the whole skirt")
+unitCounts[hydroKey] = 0
+unitCounts[energyStorageKey] = 0
+assert(not energyStorageCondition(brain), "no plant, nothing to be adjacent to")
+unitCounts[hydroKey] = 1
+economy.MassIncome = 10
+
+-- Placement is the engine's, not ours: the builders declare the adjacency
+-- category so AIBuildAdjacency puts the storage on the skirt.
+local massConstruction = massStorage.BuilderData.Construction
+assert(massConstruction.AdjacencyCategory and massConstruction.BuildStructures[1] == "MassStorage",
+    "mass storage must be placed by adjacency, not dropped anywhere near the base")
+assert(energyStorage.BuilderData.Construction.BuildStructures[1] == "EnergyStorage")
+
 local gunshipCondition = builders["Red Queen T3 Gunship Counter"].BuilderConditions[1][1]
 assert(gunshipCondition(brain), "land-loss doctrine must enable native gunship builders")
 
