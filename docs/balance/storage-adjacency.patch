+-- Storage exists for the adjacency bonus, not for the tank.
+--
+-- Red Queen built no storage of any kind before this. Each adjacent Tech 1 mass
+-- storage adds 12.5% of an extractor's yield (every extractor is SIZE4) and a
+-- 2x2 skirt takes four, so a full ring is +50%: Tech 2 goes 6/s to 9/s and pays
+-- its 800 mass back in 4.4 minutes, Tech 3 goes 18/s to 27/s and pays back in
+-- 1.5. Tech 1 would take 13 minutes and is deliberately not offered one.
+--
+-- Capped at four per upgraded extractor because a fifth touches nothing: the
+-- bonus is adjacency, so anything past the skirt is dead mass.
+local function ShouldBuildMassStorage(aiBrain)
+    local demand, economy = GetDemand(aiBrain)
+    if not demand or economy.StallRisk then
+        return false
+    end
+    local upgraded = aiBrain:GetCurrentUnits(
+        categories.STRUCTURE * categories.MASSEXTRACTION
+            * (categories.TECH2 + categories.TECH3))
+    if upgraded == 0 then
+        return false
+    end
+    local storage = aiBrain:GetCurrentUnits(categories.STRUCTURE * categories.MASSSTORAGE)
+    return storage < upgraded * Constants.Policy.MassStoragePerExtractor
+end
+
+-- The hydrocarbon plant is SIZE12, so its storages are worth far less: 8.3%
+-- each, six for +50 energy a second at 1500 mass, against 188 mass of Tech 1
+-- generators for the same energy. So this is not bought as an energy play. It
+-- is bought for the 60,000 of buffer that keeps StallRisk off a developed
+-- economy, and as a late incremental gain once the mass is genuinely spare.
+local function ShouldBuildEnergyStorage(aiBrain)
+    local demand, economy = GetDemand(aiBrain)
+    if not demand or economy.StallRisk then
+        return false
+    end
+    if economy.MassIncome < Constants.Policy.StorageAdjacencyMinimumMassIncome then
+        return false
+    end
+    local hydro = aiBrain:GetCurrentUnits(categories.STRUCTURE * categories.HYDROCARBON)
+    if hydro == 0 then
+        return false
+    end
+    local storage = aiBrain:GetCurrentUnits(categories.STRUCTURE * categories.ENERGYSTORAGE)
+    return storage < hydro * Constants.Policy.EnergyStoragePerHydrocarbon
+end
