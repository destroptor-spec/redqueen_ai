@@ -367,12 +367,63 @@ local function ShouldBuildTechEnergySmall(aiBrain)
             or aiBrain:GetCurrentUnits(categories.ENGINEER * categories.TECH3) == 0)
 end
 
+-- The share of the combat army this domain already holds, against the share the
+-- director asked for.
+--
+-- `demand.Land` and `demand.Air` were computed, clamped and written to the
+-- periodic state line, and nothing read them -- exactly the state `demand.Scouts`
+-- was in before it got a consumer. demand.Land swings 0.15 to 0.60 by doctrine
+-- and changed nothing. This is the consumer.
+--
+-- Reported rather than silent: without the figures a matrix cannot tell a gate
+-- that never fired from one that fired and did not pay.
+local function DomainDemand(aiBrain, domain)
+    local demand = GetDemand(aiBrain)
+    local want = demand and (domain == "Land" and demand.Land or domain == "Air" and demand.Air)
+    if not want or want <= 0 then
+        return nil
+    end
+    local mobile = categories.MOBILE - categories.ENGINEER - categories.COMMAND
+        - categories.SCOUT - categories.TRANSPORTFOCUS
+    local combat = aiBrain:GetCurrentUnits(mobile * (categories.LAND + categories.AIR))
+    local held = aiBrain:GetCurrentUnits(
+        mobile * (domain == "Land" and categories.LAND or categories.AIR))
+    return want, held, combat
+end
+
+local function RecordDomainShare(aiBrain, domain, held, combat, want)
+    local record = aiBrain.RedQueenDomainShare
+    if not record then
+        record = {}
+        aiBrain.RedQueenDomainShare = record
+    end
+    record[domain] = { Held = held, Combat = combat, Want = want }
+end
+
+-- True when this domain is at or above the share the director asked for, so an
+-- unconditional tier tap should stop adding to it.
+local function AtDomainShare(aiBrain, domain)
+    local want, held, combat = DomainDemand(aiBrain, domain)
+    if not want then
+        return false
+    end
+    RecordDomainShare(aiBrain, domain, held, combat, want)
+    -- An army too small to have a shape is not shaped.
+    if combat < Constants.Policy.DomainShareMinimumArmy then
+        return false
+    end
+    return held >= combat * want
+end
+
 local function ShouldBuildDominantTier(aiBrain, domain, tier)
     local demand, economy = GetDemand(aiBrain)
     local policy = demand and demand.TierPolicy and demand.TierPolicy[domain]
     return policy
         and policy.Highest == tier
         and not economy.StallRisk
+        -- Naval keeps its own demand gate (NavalDominanceMinimumDemand); this
+        -- one answers demand.Land and demand.Air, which had no consumer.
+        and not AtDomainShare(aiBrain, domain)
 end
 
